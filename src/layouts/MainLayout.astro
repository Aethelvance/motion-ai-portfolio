---
import '@/styles/variables.css';
import '@/styles/scrollbar.css';
import TwindInit from '@/components/providers/TwindInit.astro';
import SmoothScroll from '@/components/providers/SmoothScroll.astro';
import HamburgerMenu from '@/components/organisms/HamburgerMenu/HamburgerMenu';
import SideNav from '@/components/molecules/SideNav/SideNav';
import Footer from '@/components/organisms/Footer/Footer';
import AIAssistant from '@/components/organisms/AIAssistant/AIAssistant';

export interface Props {
  title?: string;
  currentPath?: string;
  showFooter?: boolean;
}

const { title = 'Ingeniero de IA', currentPath, showFooter = true } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <TwindInit />
    <SmoothScroll />
    <!-- Disable browser's automatic scroll restoration so every reload starts at the top. This keeps the SideNav's IntersectionObserver in sync with the actual scroll position. -->
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    </script>
  </head>
  <body class="min-h-screen bg-base text-text-primary font-sans antialiased">
    <HamburgerMenu currentPath={currentPath} client:load />
    <SideNav client:load />
    <slot />
    {showFooter && <Footer client:load />}
    <AIAssistant client:load />
  </body>
</html>
