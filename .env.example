# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# LLM API key (required). Get one at https://openrouter.ai/
LLM_API_KEY=your-api-key-here

# OpenAI-compatible API endpoint. Default: OpenRouter. Must use https://
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model to use. Default: google/gemma-4-26b-a4b-it
LLM_MODEL=google/gemma-4-26b-a4b-it

# Public URL of the deployed site. Used by the api service to resolve relative
# paths in the system prompt (e.g. /projects/foo.png -> https://yoursite.com/projects/foo.png).
# Required — no default. Must include https:// in production.
# Dev:        http://localhost:4321
# Production: https://your-deployed-domain.com
SITE_URL=

# CORS allowlist (comma-separated). The api is internal-only in production,
# so the browser's same-origin policy already gates access. This header is
# defense in depth. Set to "*" only for local dev.
# Dev:        *
# Production: https://your-deployed-domain.com
CORS_ORIGIN=*

# Max request body size in bytes. Default 1 MiB (1048576).
MAX_BODY_BYTES=1048576

# Container ports. Required — no defaults in code; if missing, docker compose / the api
# will fail at startup with a clear error instead of silently using a hardcoded port.
# - PORT_WEB: nginx listen port inside the web container (substituted into the listen directive
#   by the official nginx:alpine template mechanism).
# - PORT_API: the api (Node) listen port. The api code reads process.env.PORT; compose passes
#   PORT=${PORT_API} to the api container.
PORT_WEB=
PORT_API=

# plan 2.1: per-route body cap for /api/chat/upload. Default 8 MiB.
MAX_BODY_BYTES_UPLOAD=8388608

# plan 2.3: server-side chat history. Set to "0" to fall back to the legacy
# "send full history" shape (the client still sends the new shape; the api
# will treat each turn as a single-message conversation).
USE_SERVER_THREADS=1

# plan 3.2: set these ONLY in production. In dev both are unset and the
# dokploy network is a no-op local bridge. In prod DOKPLOY_EXTERNAL=true
# makes the network external (looked up by name) and DOKPLOY_NETWORK names
# the actual Dokploy-managed network. Dokploy's deploy pipeline should set
# these automatically.
# Dev:        DOKPLOY_EXTERNAL=  DOKPLOY_NETWORK=
# Production: DOKPLOY_EXTERNAL=true DOKPLOY_NETWORK=dokploy-network
DOKPLOY_EXTERNAL=
DOKPLOY_NETWORK=

# plan 5.2: server-side chat history. Default is "fs" (file-backed at
# THREADS_DIR). Set to "redis" to horizontally scale the api
# (`docker compose up --scale api=3`) with a shared store. Requires the
# `redis` package to be installed (`pnpm add redis`) and REDIS_URL set.
THREAD_STORE=fs
# Required when THREAD_STORE=redis. The compose service in the plan adds a
# `redis` container reachable at this URL inside the docker network.
REDIS_URL=redis://redis:6379
# Optional key prefix so multiple deployments can share a single Redis.
REDIS_PREFIX=default

# plan 5.6: per-IP daily token budget (prompt + completion). Counts reset
# at UTC midnight. Set to 0 to disable (default). The window is in-memory
# and per-process; with multiple api instances behind nginx the budget is
# per-instance. Set this only after you have a sense of the user's normal
# token consumption — e.g. 100000 = ~1000 short replies.
DAILY_TOKEN_BUDGET=0

# plan 4.2: opt-in client telemetry. When set, the api exposes
# POST /api/telemetry/error (validated by X-Telemetry-Token). The frontend
# reads PUBLIC_TELEMETRY_TOKEN at build time; if it matches TELEMETRY_TOKEN
# and the user has enabled the localStorage opt-in, chat failures are
# reported. Leave empty in dev to skip the endpoint entirely (it 404s).
# Set to the same long random string in both server and client envs.
TELEMETRY_TOKEN=
# Public mirror of TELEMETRY_TOKEN, exposed to the browser. Same value as
# above. Build with: PUBLIC_TELEMETRY_TOKEN=$TELEMETRY_TOKEN astro build.
PUBLIC_TELEMETRY_TOKEN=
