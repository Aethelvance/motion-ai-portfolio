# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# LLM API key (required). Get one at https://openrouter.ai/
LLM_API_KEY=your-api-key-here

# OpenAI-compatible API endpoint. Default: OpenRouter. Must use https://
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model to use. Default: google/gemma-4-26b-a4b-it
LLM_MODEL=google/gemma-4-26b-a4b-it

# Public URL of the deployed site. Used by the api service to resolve relative
# paths in the system prompt (e.g. /projects/foo.png -> https://yoursite.com/projects/foo.png).
# Dev:        http://localhost:4321
# Production: https://your-deployed-domain.com (must include https://)
SITE_URL=http://localhost:4321

# CORS allowlist (comma-separated). The api is internal-only in production,
# so the browser's same-origin policy already gates access. This header is
# defense in depth. Set to "*" only for local dev.
# Dev:        *
# Production: https://your-deployed-domain.com
CORS_ORIGIN=*

# Max request body size in bytes. Default 1 MiB (1048576).
MAX_BODY_BYTES=1048576

# Container ports (override only if you know why)
# - PORT_WEB: nginx listen port inside the web container (used by Traefik/nginx proxy).
#   Default 4321. The default nginx:alpine template mechanism substitutes ${NGINX_PORT}.
# - PORT_API: the api (Node) listen port. The api code reads process.env.PORT; we pass
#   PORT=${PORT_API} from compose. Default 3000.
PORT_WEB=4321
PORT_API=3000
