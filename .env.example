# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# LLM API key (required). Get one at https://platform.openai.com/api-keys
LLM_API_KEY=your-api-key-here

# OpenAI-compatible API endpoint. Change for other providers (Anthropic, OpenRouter, etc.)
LLM_BASE_URL=https://api.openai.com/v1

# Model to use
LLM_MODEL=gpt-3.5-turbo

# Server port
PORT=3001
