# Build the Astro static site, then serve it with nginx. nginx also proxies /api/* to the api service.
# Build arg PUBLIC_API_URL is the base URL the frontend uses to call the chat API.
# In docker-compose it's set to "/api" so the browser calls /api/chat (proxied by nginx to the api container).
# In dev it defaults to "http://localhost:3001".

FROM node:22-alpine AS builder
WORKDIR /app

# CI=true prevents pnpm from prompting for confirmation in non-TTY environments
ENV CI=true
RUN corepack enable

# Install deps first for layer caching. pnpm 11+ strict mode errors on
# unapproved build scripts; we use --ignore-scripts and rebuild natives after.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm rebuild esbuild sharp

# Copy the rest and build
COPY . .

ARG PUBLIC_API_URL=/api
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

RUN pnpm build

# Diagnostic: list the build output so the deploy log shows exactly what `pnpm build` produced.
# This layer is intentionally not in cache: touching /tmp breaks cache and forces re-run.
# Will be removed once the deploy is verified working. (status: pending)
RUN echo "=== pnpm build output ===" \
    && ls -la /app/dist/ \
    && echo "=== html files ===" \
    && find /app/dist -name "*.html" -type f \
    && echo "=== index.html size ===" \
    && wc -c /app/dist/index.html 2>/dev/null || echo "NO index.html" \
    && echo "=== end diagnostic ==="

# Runtime: serve dist/ with nginx and proxy /api/* to the api service.
# NOTE: runs as root intentionally. nginx is the only process in this container,
# needs to bind port 80 (privileged), and the official nginx:alpine image creates
# /var/cache/nginx and /var/log/nginx as root which the nginx user can't write to.
# Docker's container isolation provides the security boundary; the api (which
# handles untrusted input) runs as non-root `node` user in its own container.
# nginx.conf is placed under /etc/nginx/templates/ so the official entrypoint's
# 20-envsubst-on-templates.sh substitutes ${NGINX_PORT} and ${NGINX_API_PORT} from
# the container environment at startup, then writes the result to
# /etc/nginx/conf.d/default.conf before launching nginx.
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template
EXPOSE ${NGINX_PORT}
CMD ["nginx", "-g", "daemon off;"]
