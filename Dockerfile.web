# Build the Astro static site, then serve it with nginx. nginx also proxies /api/* to the api service.
# Build arg PUBLIC_API_URL is the base URL the frontend uses to call the chat API.
# In docker-compose it's set to "/api" so the browser calls /api/chat (proxied by nginx to the api container).
# In dev it defaults to "http://localhost:3001".

FROM node:22-alpine AS builder
WORKDIR /app

# CI=true prevents pnpm from prompting for confirmation in non-TTY environments
ENV CI=true
RUN corepack enable

# Install deps first for layer caching. Include pnpm-workspace.yaml for pnpm 11+ settings.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile \
    && pnpm rebuild esbuild

# Copy the rest and build
COPY . .

ARG PUBLIC_API_URL=/api
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

RUN pnpm build

# Runtime: serve dist/ with nginx and proxy /api/* to the api service
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
