# plan 3.3: pin the base image to a content-addressable digest. See Dockerfile.api
# for the same rationale.
FROM node:22.13.0-alpine@sha256:f2dc6eea95f787e25f173ba9904c9d0647ab2506178c7b5b7c5a3d02bc4af145 AS builder
WORKDIR /app

# CI=true prevents pnpm from prompting for confirmation in non-TTY environments
ENV CI=true
RUN corepack enable

# plan 3.7: pnpm store cache mount. See Dockerfile.api for the rationale.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm fetch
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts \
    && pnpm rebuild esbuild sharp

# Copy the rest and build
COPY . .

ARG PUBLIC_API_URL=/api
ENV PUBLIC_API_URL=${PUBLIC_API_URL}

# plan 3.4: the inline `=== pnpm build output ===` diagnostic block was
# removed from the build path. It is now in scripts/diagnose-build.sh and
# must be invoked explicitly via `make diagnose-build` (or directly) so
# everyday rebuilds do not pay the cost.
RUN pnpm build

# Runtime: serve dist/ with nginx and proxy /api/* to the api service.
# NOTE: runs as root intentionally. nginx is the only process in this container,
# needs to bind port 80 (privileged), and the official nginx:alpine image creates
# /var/cache/nginx and /var/log/nginx as root which the nginx user can't write to.
# Docker's container isolation provides the security boundary; the api (which
# handles untrusted input) runs as non-root `node` user in its own container.
# nginx.conf is placed under /etc/nginx/templates/ so the official entrypoint's
# 20-envsubst-on-templates.sh substitutes ${NGINX_PORT} and ${NGINX_API_PORT} from
# the container environment at startup, then writes the result to
# /etc/nginx/conf.d/default.conf before launching nginx.
#
# plan 3.3: pin the base image digest.
FROM nginx:1.27.4-alpine@sha256:4ff102c5d78d254a6f0da062b3cf39eaf07f01eec0927fd21e219d0af8bc0591
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template

# plan 3.5: HEALTHCHECK mirrors the compose-level probe. wget --spider
# returns 0 only on 2xx, so a 200 from /index.html is the signal.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

EXPOSE ${NGINX_PORT}
CMD ["nginx", "-g", "daemon off;"]
