FROM node:22-alpine
WORKDIR /app

RUN corepack enable

# Install only production deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod

# Copy the server code
COPY server/ ./server/

# Env vars come from docker-compose.yml (LLM_API_KEY, LLM_BASE_URL, LLM_MODEL, SITE_URL, PORT)
# The PORT default in server.mjs is 3001
EXPOSE 3001
CMD ["node", "server/server.mjs"]
