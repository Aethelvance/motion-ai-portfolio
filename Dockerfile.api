FROM node:22-alpine
WORKDIR /app

# CI=true prevents pnpm from prompting for confirmation in non-TTY environments
ENV CI=true
RUN corepack enable

# Install only production deps. The post-install rebuild is needed because pnpm 11+
# errors on ignored build scripts by default (esbuild needs its native binary unpacked).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod \
    && pnpm rebuild esbuild

# Copy the api code
COPY api/ ./api/

# Env vars come from docker-compose.yml (LLM_API_KEY, LLM_BASE_URL, LLM_MODEL, SITE_URL, PORT)
# The PORT default in app.mjs is 3001
EXPOSE 3001
CMD ["node", "api/app.mjs"]
